<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>星屑與月光：N1日語深淵迴廊</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&family=Zen+Maru+Gothic:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-paper: #FBF8F3;
      --bg-card: #FFFDF9;
      --bg-soft: #F3ECE1;
      --ink-main: #3D3530;
      --ink-muted: #7C7068;
      --accent-rose: #D99B9F;
      --accent-rose-light: #F7E8E9;
      --accent-sage: #8FA391;
      --accent-sage-light: #E8EFE9;
      --accent-blue: #869EB4;
      --accent-gold: #C9A96E;
      --border-soft: rgba(61, 53, 48, 0.14);
      --shadow-soft: 0 10px 30px rgba(61, 53, 48, 0.06);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Zen Maru Gothic', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-paper);
      background-image:
        radial-gradient(circle at 15% 15%, rgba(232, 180, 184, 0.14) 0%, transparent 45%),
        radial-gradient(circle at 85% 80%, rgba(156, 175, 158, 0.15) 0%, transparent 45%);
      color: var(--ink-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 20px 16px 40px;
    }

    .app-shell {
      width: 100%;
      max-width: 820px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 12px 18px;
      box-shadow: var(--shadow-soft);
      flex-wrap: wrap;
      gap: 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-badge {
      background: var(--accent-rose-light);
      color: #A86469;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      letter-spacing: 0.05em;
    }

    .brand-title {
      font-family: 'Noto Serif JP', 'Noto Sans TC', serif;
      font-size: 17px;
      font-weight: 700;
      color: var(--ink-main);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stat-pill {
      background: var(--bg-soft);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 13px;
      color: var(--ink-main);
      font-weight: 500;
    }

    .btn-ghost {
      background: transparent;
      border: 1px solid var(--border-soft);
      color: var(--ink-main);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .btn-ghost:hover {
      background: var(--bg-soft);
      border-color: rgba(61, 53, 48, 0.3);
    }

    .stage-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 14px;
    }

    .stage-card {
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 20px;
      padding: 18px;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
    }

    .stage-card:hover {
      transform: translateY(-3px);
      border-color: var(--accent-rose);
      box-shadow: 0 14px 32px rgba(61, 53, 48, 0.09);
    }

    .stage-tag {
      font-size: 11px;
      color: var(--ink-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .stage-name {
      font-family: 'Noto Serif JP', 'Noto Sans TC', serif;
      font-size: 17px;
      font-weight: 700;
      margin-top: 4px;
    }

    .stage-desc {
      font-size: 13px;
      color: var(--ink-muted);
      line-height: 1.5;
    }

    .stage-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      padding-top: 8px;
      border-top: 1px dashed var(--border-soft);
    }

    .battle-card {
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 24px;
      padding: 22px;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .scene-box {
      background: linear-gradient(180deg, #F6F1E9 0%, #EFE7DA 100%);
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
    }

    .scene-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-size: 13px;
      color: var(--ink-muted);
    }

    .fighters-row {
      display: flex;
      justify-content: space-around;
      align-items: flex-end;
      min-height: 145px;
      padding: 6px 0;
    }

    .fighter {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      width: 44%;
    }

    .hp-wrap {
      width: 100%;
      max-width: 165px;
    }

    .hp-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--ink-muted);
      margin-bottom: 4px;
    }

    .hp-track {
      height: 7px;
      background: rgba(61, 53, 48, 0.1);
      border-radius: 999px;
      overflow: hidden;
    }

    .hp-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.35s ease;
    }

    .hp-hero { background: var(--accent-sage); }
    .hp-enemy { background: var(--accent-rose); }

    @keyframes floatSoft {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }

    @keyframes shakeHit {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-7px); }
      75% { transform: translateX(7px); }
    }

    .sprite-float { animation: floatSoft 3.2s ease-in-out infinite; }
    .sprite-hit { animation: shakeHit 0.35s ease; }

    .question-box {
      background: var(--bg-paper);
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 18px 20px;
    }

    .q-category {
      display: inline-block;
      font-size: 12px;
      color: #846A42;
      background: #F5EBD9;
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .q-text {
      font-family: 'Noto Serif JP', 'Noto Sans TC', serif;
      font-size: 19px;
      line-height: 1.75;
      color: var(--ink-main);
    }

    .q-target {
      text-decoration: underline;
      text-decoration-color: var(--accent-rose);
      text-decoration-thickness: 2px;
      text-underline-offset: 5px;
      font-weight: 700;
      padding: 0 2px;
    }

    .options-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 11px;
    }

    @media (max-width: 560px) {
      .options-grid { grid-template-columns: 1fr; }
    }

    .opt-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 13px 16px;
      text-align: left;
      font-family: 'Noto Serif JP', 'Noto Sans TC', serif;
      font-size: 16px;
      color: var(--ink-main);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.18s ease;
    }

    .opt-btn:hover:not(:disabled) {
      background: var(--bg-soft);
      border-color: var(--accent-blue);
      transform: translateY(-1px);
    }

    .opt-key {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--bg-soft);
      color: var(--ink-muted);
      font-family: 'Zen Maru Gothic', 'Noto Sans TC', sans-serif;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .opt-btn.correct {
      background: var(--accent-sage-light);
      border-color: var(--accent-sage);
      color: #2E4A32;
    }

    .opt-btn.wrong {
      background: var(--accent-rose-light);
      border-color: var(--accent-rose);
      color: #7D3B40;
    }

    .feedback-panel {
      background: #F8F4EC;
      border-left: 3px solid var(--accent-gold);
      border-radius: 12px;
      padding: 15px 18px;
      display: none;
      flex-direction: column;
      gap: 8px;
      font-size: 14px;
      line-height: 1.65;
    }

    .feedback-panel.show { display: flex; }

    .fb-example {
      font-family: 'Noto Serif JP', 'Noto Sans TC', serif;
      background: var(--bg-card);
      padding: 9px 12px;
      border-radius: 10px;
      border: 1px solid var(--border-soft);
      font-size: 14px;
    }

    .btn-primary {
      align-self: flex-end;
      background: var(--ink-main);
      color: #FFFDF9;
      border: none;
      padding: 10px 20px;
      border-radius: 999px;
